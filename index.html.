
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090909">
<title>F.H. Netherlands Live Cams</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#090909;
 color:white;
 font-family:Arial,sans-serif;
}
header{
 padding:28px 18px;
 background:#151515;
 border-bottom:2px solid #e00025;
}
.logo{
 font-size:32px;
 font-weight:900;
 color:#ed1238;
}
header p{color:#aaa}
main{
 padding:20px;
 max-width:850px;
 margin:auto;
}
h2{color:#ed1238}
input,select{
 width:100%;
 padding:14px;
 margin:7px 0 15px;
 background:#202020;
 color:white;
 border:1px solid #444;
 border-radius:9px;
 font-size:16px;
}
.card{
 background:#181818;
 border:1px solid #333;
 border-left:4px solid #e00025;
 border-radius:12px;
 padding:17px;
 margin:13px 0;
}
.card h3{margin:0 0 8px}
.card p{color:#bbb;font-size:14px}
a.open{
 display:inline-block;
 background:#e00025;
 color:white;
 text-decoration:none;
 padding:11px 16px;
 border-radius:7px;
 font-weight:bold;
}
.tag{color:#ff526f;font-size:12px}
footer{
 text-align:center;
 color:#777;
 padding:30px;
 font-size:12px;
}
</style>
</head>
<body>
<header>
 <div class="logo">F.H. LIVE CAMS</div>
 <p>Netherlands Public Webcam Directory</p>
</header>

<main>
 <h2>Zoek een webcam</h2>

 <input id="search"
 placeholder="Zoek bijvoorbeeld Drachten..."
 oninput="render()">

 <select id="region" onchange="render()">
  <option value="all">Heel Nederland</option>
  <option value="Friesland">Friesland</option>
  <option value="Nederland">Overige Nederland</option>
 </select>

 <div id="cams"></div>

 <h2>Over F.H.</h2>
 <p>
 F.H. verzamelt links naar publiek aangeboden webcams.
 Je wordt doorgestuurd naar de officiële website van de aanbieder.
 </p>
</main>

<footer>F.H. Netherlands Live Cams © 2026</footer>

<script>
const cameras=[
 {
 name:"Friesland Webcams",
 place:"Friesland",
 region:"Friesland",
 url:"https://bekijkhet.nu/cams-fr.html",
 desc:"Openbare webcamvermeldingen in Friesland."
 },
 {
 name:"Leeuwarden",
 place:"Leeuwarden",
 region:"Friesland",
 url:"https://bekijkhet.nu/cams-fr.html",
 desc:"Bekijk beschikbare camerabronnen via de webcamdirectory."
 },
 {
 name:"Drachten",
 place:"Drachten",
 region:"Friesland",
 url:"https://bekijkhet.nu/cams-fr.html",
 desc:"Zoek openbare webcams in de omgeving."
 },
 {
 name:"Sneek",
 place:"Sneek",
 region:"Friesland",
 url:"https://bekijkhet.nu/cams-fr.html",
 desc:"Openbare webcamdirectory voor Friesland."
 },
 {
 name:"Dokkum",
 place:"Dokkum",
 region:"Friesland",
 url:"https://bekijkhet.nu/cams-fr.html",
 desc:"Openbare webcamdirectory voor Friesland."
 },
 {
 name:"Harlingen",
 place:"Harlingen",
 region:"Friesland",
 url:"https://bekijkhet.nu/cams-fr.html",
 desc:"Openbare webcamdirectory voor Friesland."
 },
 {
 name:"Rijkswaterstaat Verkeerscamera's",
 place:"Nederland",
 region:"Nederland",
 url:"https://www.rwsverkeersinfo.nl/cameras/",
 desc:"Officiële verkeerscamera-informatie."
 },
 {
 name:"Heel Holland Kijkt",
 place:"Nederland",
 region:"Nederland",
 url:"https://heelhollandkijkt.nl/",
 desc:"Directory met openbare webcams uit Nederland."
 }
];

function render(){
 const q=document.getElementById('search').value.toLowerCase();
 const r=document.getElementById('region').value;

 const filtered=cameras.filter(c=>
  (r==="all"||c.region===r)&&
  (c.name+" "+c.place).toLowerCase().includes(q)
 );

 document.getElementById('cams').innerHTML=
 filtered.map(c=>`
  <div class="card">
   <span class="tag">${c.region}</span>
   <h3>${c.name}</h3>
   <p>${c.desc}</p>
   <a class="open"
    href="${c.url}"
    target="_blank"
    rel="noopener">
    Bekijk webcambron ↗
   </a>
  </div>
 `).join('')||'<p>Geen webcams gevonden.</p>';
}

render();
</script>
</body>
</html>
